# Caddy in front of the Streamlit page (docker-compose service
# "caddy" -> "retrain-ui"), served at https://chronophotoai.ca. Caddy
# gets the HTTPS certificate from Let's Encrypt by itself and proxies
# the WebSocket Streamlit needs.
#
# Setup:
#   1. At the registrar, point an A record for chronophotoai.ca (@) at
#      this server's public IP, and a CNAME for www at chronophotoai.ca.
#      Open ports 80 and 443 in the firewall. Port 8501 stays closed.
#   2. Make a password hash (bcrypt):
#        docker compose run --rm caddy caddy hash-password --plaintext 'your-password'
#   3. Replace the user name and the hash below, then:
#        docker compose up -d
#   4. Open https://chronophotoai.ca and log in.

chronophotoai.ca {
    basic_auth {
        admin $2a$14$REPLACE_WITH_THE_HASH_FROM_STEP_2
    }

    reverse_proxy retrain-ui:8501
}

# www.chronophotoai.ca sends visitors to the main address.
www.chronophotoai.ca {
    redir https://chronophotoai.ca{uri} permanent
}

# No domain (office network only)? Replace the blocks above with this
# one: plain HTTP on port 80 at http://<server-ip>, same password.
#
# :80 {
#     basic_auth {
#         admin $2a$14$REPLACE_WITH_THE_HASH_FROM_STEP_2
#     }
#
#     reverse_proxy retrain-ui:8501
# }
